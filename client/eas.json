{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildType": "archive"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://where-we-going-hazel.vercel.app/api"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildType": "archive"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://where-we-going-hazel.vercel.app/api"
      }
    }
  }
}