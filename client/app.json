{
  "expo": {
    "name": "Where We Going",
    "slug": "WhereWeGoing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon/WWG_transparent.png",
    "scheme": "wherewegoing",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon/WWG_transparent.png",
      "bundleIdentifier": "com.pater10.WhereWeGoing",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Aplikacja potrzebuje dostępu do galerii, aby ustawić avatar.",
        "NSCameraUsageDescription": "Aplikacja potrzebuje dostępu do aparatu, aby wykonać zdjęcie avatara.",
        "NSMicrophoneUsageDescription": "Aplikacja potrzebuje dostępu do mikrofonu do nagrywania dźwięku.",
        "NSLocationWhenInUseUsageDescription": "Aplikacja użyje lokalizacji, aby oszacować dojazd do celu podróży i pokazać trasę z Twojego miejsca do planu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon/WWG_transparent.png",
        "monochromeImage": "./assets/images/icon/WWG_transparent.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.pater10.WhereWeGoing"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon/WWG_transparent.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikacja użyje lokalizacji, aby oszacować dojazd do celu podróży i pokazać trasę z Twojego miejsca do planu."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon/WWG_white.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/icon/WWG_dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacja potrzebuje dostepu do galerii, aby ustawic avatar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23ffce43-ca91-4d2c-b05a-05a41bba24b3"
      }
    }
  }
}
